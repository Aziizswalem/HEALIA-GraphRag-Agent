DEMO_MODE=false

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
MCP_ENABLED=false
MCP_URL=http://your-mcp-host:8005/mcp/
MCP_AUTHORIZATION=Basic your-base64-credentials
MCP_TIMEOUT_SECONDS=15

LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

SCHEMA_CACHE_TTL_SECONDS=1800
SCHEMA_VERSION=v1
SCHEMA_CACHE_PREFIX=graphrag:schema
# Property keys from apoc.meta.schema: keep keys with existence >= this (0 = drop only existence==0).
SCHEMA_PROPERTY_MIN_EXISTENCE=0
SCHEMA_MAX_PROPERTIES_PER_ENTITY=64
SCHEMA_MAX_PROPERTIES_IN_PATTERN=20
# JSON: labels/properties whose DISTINCT values are sampled into the Cypher prompt (e.g. map "radio" → "radiologie").
SCHEMA_ENUM_HINTS='{"ActeMedical":["type"]}'
SCHEMA_ENUM_VALUE_LIMIT=200

# Example for Ollama on a remote GPU instance through an SSH tunnel.
# First run:
# ssh -L 11435:127.0.0.1:11434 user@your-gpu-instance-ip
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=http://127.0.0.1:11435/v1
# OPENAI_API_KEY=ollama
# OPENAI_CHAT_MODEL=qwen3-coder-next:q8_0

# Example for a GPU cloud endpoint exposing an OpenAI-compatible API:
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://your-gpu-endpoint.example.com/v1
# OPENAI_API_KEY=your-internal-api-key
# OPENAI_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct

JWT_SECRET=
JWT_ALGORITHM=HS256
DATABASE_URL=
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=logs/audit_log.jsonl
OBSERVABILITY_LOG_PATH=logs/observability.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
# Origines CORS autorisées (séparées par des virgules).
# Ajouter l'URL d'Odoo 15 pour l'intégration du module healio_chatbot.
# Exemple si Odoo est sur le même serveur : http://localhost:8069
# Exemple si Odoo est sur un autre serveur : http://192.168.1.50:8069
API_CORS_ORIGINS=http://localhost:8069,http://127.0.0.1:8069
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_TOKENS_PER_SECOND=1.0
RATE_LIMIT_PREFIX=graphrag:ratelimit
PII_FILTER_ENABLED=true
SESSION_TTL_SECONDS=86400
CONVERSATION_MAX_TURNS=12
CONVERSATION_CONTEXT_TURNS=6
SESSION_CACHE_PREFIX=graphrag:session
SESSION_COOKIE_NAME=stagee_session_id
RESULT_SANITIZER_SALT=change-me
RESULT_SANITIZER_HASH_LENGTH=12
